Cell[CellGroupData[{

Cell["Milky way ", "Subsection",
 CellChangeTimes->{{3.815008997117831*^9, 
  3.815009004205122*^9}},ExpressionUUID->"2f209745-6f2e-49df-828d-\
314c4fe72ac7"],

Cell["\<\
Check for the halo tidal field it is supposed to peak near 5kpc\
\>", "Text",
 CellChangeTimes->{{3.8150090080572853`*^9, 3.8150090102757063`*^9}, {
  3.815009179273242*^9, 
  3.815009203493692*^9}},ExpressionUUID->"b6c8dc27-c4bd-4601-884b-\
93f75a212977"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Rho]", "[", "R_", "]"}], " ", ":=", " ", 
  FractionBox["\[Rho]Milkyway", 
   RowBox[{"1", "+", 
    FractionBox[
     SuperscriptBox["R", "2"], 
     SuperscriptBox["RcMilkyway", "2"]]}]]}]], "Input",
 CellChangeTimes->{{3.705021259171418*^9, 3.7050213339741707`*^9}, {
   3.705021481011366*^9, 3.70502148263651*^9}, 3.705058009971114*^9, {
   3.7050581693724833`*^9, 3.705058175316245*^9}, {3.709077698853808*^9, 
   3.7090777010397577`*^9}, {3.8150095320444803`*^9, 3.8150095676601467`*^9}},
 
 CellLabel->"In[29]:=",ExpressionUUID->"fc10ba92-bddd-437d-89c3-1cfaf1fa5d64"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   SubscriptBox["\[Phi]", "halo"], "[", 
   RowBox[{"x_", ",", "y_", ",", "z_"}], "]"}], " ", ":=", " ", 
  RowBox[{
   RowBox[{"-", 
    RowBox[{"(", 
     RowBox[{"4", "*", "Pi", "*", "G", "*", "\[Rho]Milkyway", "*", 
      SuperscriptBox["RcMilkyway", "2"]}], ")"}]}], 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"0.5", "*", 
      RowBox[{"Log", "[", 
       RowBox[{
        SuperscriptBox["RcMilkyway", "2"], "+", 
        RowBox[{"x", "^", "2"}], "+", 
        RowBox[{"y", "^", "2"}], "+", 
        RowBox[{"z", "^", "2"}]}], "]"}]}], "+", 
     RowBox[{
      FractionBox["RcMilkyway", 
       SqrtBox[
        RowBox[{
         RowBox[{"x", "^", "2"}], "+", 
         RowBox[{"y", "^", "2"}], "+", 
         RowBox[{"z", "^", "2"}]}]]], "*", 
      RowBox[{"ArcTan", "[", 
       FractionBox[
        SqrtBox[
         RowBox[{
          RowBox[{"x", "^", "2"}], "+", 
          RowBox[{"y", "^", "2"}], "+", 
          RowBox[{"z", "^", "2"}]}]], "RcMilkyway"], " ", "]"}]}], "-", "1"}],
     ")"}]}]}]], "Input",
 CellChangeTimes->{{3.815009557428475*^9, 3.815009561225904*^9}, {
  3.815010225249031*^9, 3.81501032353043*^9}},
 CellLabel->"In[30]:=",ExpressionUUID->"6249e7d3-75b8-4663-a28e-0157476e9b8d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Texponential", "[", "x_", "]"}], ":=", 
  RowBox[{"2", "Pi", " ", "G", " ", 
   RowBox[{"(", 
    RowBox[{"\[CapitalSigma]", "/", "rd"}], ")"}], " ", 
   RowBox[{"(", " ", 
    RowBox[{
     RowBox[{"2", " ", 
      FractionBox["x", "rd"], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"BesselI", "[", 
          RowBox[{"0", ",", 
           RowBox[{"x", "/", "rd"}]}], "]"}], 
         RowBox[{"BesselK", "[", 
          RowBox[{"1", ",", 
           RowBox[{"x", "/", "rd"}]}], "]"}]}], "-", 
        RowBox[{
         RowBox[{"BesselI", "[", 
          RowBox[{"1", ",", 
           RowBox[{"x", "/", "rd"}]}], "]"}], 
         RowBox[{"BesselK", "[", 
          RowBox[{"0", ",", 
           RowBox[{"x", "/", "rd"}]}], "]"}]}]}], ")"}]}], "-", 
     RowBox[{
      RowBox[{"BesselI", "[", 
       RowBox[{"0", ",", 
        RowBox[{"x", "/", "rd"}]}], "]"}], 
      RowBox[{"BesselK", "[", 
       RowBox[{"0", ",", 
        RowBox[{"x", "/", "rd"}]}], "]"}]}], "-", 
     RowBox[{
      RowBox[{"BesselI", "[", 
       RowBox[{"1", ",", 
        RowBox[{"x", "/", "rd"}]}], "]"}], 
      RowBox[{"BesselK", "[", 
       RowBox[{"1", ",", 
        RowBox[{"x", "/", "rd"}]}], "]"}]}]}], ")"}]}]}]], "Input",
 CellLabel->"In[31]:=",ExpressionUUID->"11d6b337-642d-4b10-baef-113725365ef4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Thalo2511", "[", "x_", "]"}], ":=", " ", 
  RowBox[{
   RowBox[{"-", 
    RowBox[{"(", 
     RowBox[{"4", " ", "Pi", " ", "G", " ", "\[Rho]Milkyway", " ", 
      SuperscriptBox["RcMilkyway", "2"]}], ")"}]}], " ", 
   RowBox[{"(", 
    RowBox[{
     FractionBox[
      RowBox[{
       SuperscriptBox["RcMilkyway", "2"], "-", 
       SuperscriptBox["x", "2"]}], 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox["RcMilkyway", "2"], "+", 
         SuperscriptBox["x", "2"]}], ")"}], "2"]], "-", " ", 
     FractionBox[
      RowBox[{"1", "+", " ", 
       RowBox[{"3", " ", 
        FractionBox[
         SuperscriptBox["x", "2"], 
         SuperscriptBox["RcMilkyway", "2"]]}]}], 
      RowBox[{
       SuperscriptBox["x", "2"], 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"1", "+", " ", 
          FractionBox[
           SuperscriptBox["x", "2"], 
           SuperscriptBox["RcMilkyway", "2"]]}], ")"}], "2"]}]], " ", "-", 
     " ", 
     RowBox[{
      FractionBox["RcMilkyway", 
       SuperscriptBox["x", "3"]], "  ", 
      RowBox[{"(", 
       RowBox[{
        FractionBox["x", 
         RowBox[{"RcMilkyway", " ", 
          RowBox[{"(", 
           RowBox[{"1", "+", " ", 
            FractionBox[
             SuperscriptBox["x", "2"], 
             SuperscriptBox["RcMilkyway", "2"]]}], ")"}]}]], "-", " ", 
        RowBox[{"2", 
         RowBox[{"ArcTan", "[", 
          FractionBox["x", "RcMilkyway"], "]"}]}]}], ")"}]}]}], 
    ")"}]}]}]], "Input",
 CellChangeTimes->{{3.815268901903598*^9, 3.8152691795949078`*^9}, 
   3.8152693093271923`*^9},
 CellLabel->"In[32]:=",ExpressionUUID->"656944ad-a07e-415f-9f50-2ba6990645e7"],

