  RowBox[{"Vhalo", "[", "r_", "]"}], " ", ":=", 
  RowBox[{"2", " ", 
   SqrtBox["\[Pi]"], " ", 
   SqrtBox[
    RowBox[{"G", " ", "r", " ", 
     SuperscriptBox["RcMilkyway", "2"], " ", "\[Rho]Milkyway", " ", 
     RowBox[{"(", 
