Cell[CellGroupData[{

Cell["UGC 7321", "Subsection",
 CellChangeTimes->{{3.816991687882703*^9, 
  3.8169916954507933`*^9}},ExpressionUUID->"65bad01a-e1ae-407d-ad2b-\
ff9cebe986fd"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Thalougc", "[", "x_", "]"}], ":=", " ", 
  RowBox[{
   RowBox[{"-", 
    RowBox[{"(", 
     RowBox[{"4", " ", "Pi", " ", "G", " ", "\[Rho]UGC7321", " ", 
      SuperscriptBox["RcUGC7321", "2"]}], ")"}]}], " ", 
   RowBox[{"(", 
    RowBox[{
     FractionBox[
      RowBox[{
       SuperscriptBox["RcUGC7321", "2"], "-", 
       SuperscriptBox["x", "2"]}], 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox["RcUGC7321", "2"], "+", 
         SuperscriptBox["x", "2"]}], ")"}], "2"]], "-", " ", 
     FractionBox[
      RowBox[{"1", "+", " ", 
       RowBox[{"3", " ", 
        FractionBox[
         SuperscriptBox["x", "2"], 
         SuperscriptBox["RcUGC7321", "2"]]}]}], 
      RowBox[{
       SuperscriptBox["x", "2"], 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"1", "+", " ", 
          FractionBox[
           SuperscriptBox["x", "2"], 
           SuperscriptBox["RcUGC7321", "2"]]}], ")"}], "2"]}]], " ", "-", " ", 
     RowBox[{
      FractionBox["RcUGC7321", 
       SuperscriptBox["x", "3"]], "  ", 
      RowBox[{"(", 
       RowBox[{
        FractionBox["x", 
         RowBox[{"RcUGC7321", " ", 
          RowBox[{"(", 
           RowBox[{"1", "+", " ", 
            FractionBox[
             SuperscriptBox["x", "2"], 
             SuperscriptBox["RcUGC7321", "2"]]}], ")"}]}]], "-", " ", 
        RowBox[{"2", 
         RowBox[{"ArcTan", "[", 
          FractionBox["x", "RcUGC7321"], "]"}]}]}], ")"}]}]}], 
    ")"}]}]}]], "Input",
 CellChangeTimes->{{3.816991736629003*^9, 3.816991782903816*^9}},
 CellLabel->"In[38]:=",ExpressionUUID->"e824dea6-85c6-48c4-8095-29d1221a4bab"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Thalougc", "[", 
      RowBox[{"x", "*", "1000"}], "]"}], ",", 
     RowBox[{
      RowBox[{"Texponential", "[", 
       RowBox[{"x", "*", "1000"}], "]"}], "/.", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
        "\[CapitalSigma]", " ", "\[Rule]", " ", "\[CapitalSigma]UGC7231"}], 
        ",", 
        RowBox[{"rd", "\[Rule]", " ", "RdUGC7321"}]}], "}"}]}], ",", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"Thalougc", "[", 
         RowBox[{"x", "*", "1000"}], "]"}], "+", 
        RowBox[{"Texponential", "[", 
         RowBox[{"x", "*", "1000"}], "]"}]}], "/.", 
       RowBox[{"{", 
