      RowBox[{"-", 
       RowBox[{"BesselI", "[", 
        RowBox[{"0", ",", 
         FractionBox["x", "rd"]}], "]"}]}], " ", 
      RowBox[{"BesselK", "[", 
       RowBox[{"0", ",", 
        FractionBox["x", "rd"]}], "]"}]}], "-", 
     RowBox[{
      RowBox[{"BesselI", "[", 
       RowBox[{"1", ",", 
        FractionBox["x", "rd"]}], "]"}], " ", 
      RowBox[{"BesselK", "[", 
       RowBox[{"1", ",", 
        FractionBox["x", "rd"]}], "]"}]}], "+", 
     FractionBox[
      RowBox[{"2", " ", "x", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"-", 
           RowBox[{"BesselI", "[", 
            RowBox[{"1", ",", 
             FractionBox["x", "rd"]}], "]"}]}], " ", 
          RowBox[{"BesselK", "[", 
           RowBox[{"0", ",", 
            FractionBox["x", "rd"]}], "]"}]}], "+", 
         RowBox[{
          RowBox[{"BesselI", "[", 
           RowBox[{"0", ",", 
            FractionBox["x", "rd"]}], "]"}], " ", 
          RowBox[{"BesselK", "[", 
           RowBox[{"1", ",", 
            FractionBox["x", "rd"]}], "]"}]}]}], ")"}]}], "rd"]}], ")"}]}], 
  "rd"]], "Output",
 CellChangeTimes->{
  3.812879808209649*^9, 3.81296329526571*^9, 3.813132185421843*^9, 
   3.813135325221531*^9, 3.8131354802624826`*^9, 3.8132847342494087`*^9, 
